# Build configuration for premium editions. Copy to .env (not committed).
# Real environment variables take precedence over values in this file.
# Falls back to the shared iYi license env names if the SLEDGE_BUNDLES_* keys are unset.

# Path to the RSA public key generated alongside the main site's private key.
IYI_LICENSE_PUBLIC_KEY_FILE='E:/wamp/www/iYi/main-site/secrets/iyi-license-public.pem'

# Optional: plugin-specific aliases
# SLEDGE_BUNDLES_LICENSE_PUBLIC_KEY_FILE='E:/wamp/www/iYi/main-site/secrets/iyi-license-public.pem'

# Optional: override the licensing endpoint (defaults to iyisolutions.com).
# IYI_LICENSE_ENDPOINT='https://iyisolutions.com/api/licenses/validate'
# SLEDGE_BUNDLES_LICENSE_ENDPOINT='https://iyisolutions.com/api/licenses/validate'
